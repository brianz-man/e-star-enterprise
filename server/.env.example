# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# Comma-separated frontend origins allowed by CORS; set the exact Vercel production URL
CLIENT_URL=http://localhost:5173

# Public URL of this API — used for M-Pesa callback registration
API_BASE_URL=http://localhost:5000

# Set to "true" to serve the built React app from Express (single-container deploy)
SERVE_CLIENT=false

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/estar?schema=public

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_TTL_MS=604800000
BCRYPT_ROUNDS=12
# Use "none" only for cross-site Render/Vercel deployments; use "lax" or "strict"
# with custom frontend/API domains on the same site.
COOKIE_SAME_SITE="strict"

# Set to true only while investigating SQL locally. Query logs can include values.
PRISMA_QUERY_LOG=false

# ─── Cloudinary (product images) ──────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── M-Pesa (Daraja) ─────────────────────────────────────────────────────────
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_ENV=sandbox

# Production requires at least one callback protection method.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MPESA_CALLBACK_SECRET=

# Optional: comma-separated caller IP allowlist (only use with correctly configured trusted proxies)
# MPESA_CALLBACK_IPS=

# ─── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=E-Star Orders <orders@e-star.co.ke>
